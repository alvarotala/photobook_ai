# OpenAI, utilizada únicamente por el servidor Python.
OPENAI_API_KEY=sk-reemplazar
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_PROFILE=balanced

# xAI, utilizada por el script de benchmark.
XAI_API_KEY=xai-reemplazar
XAI_IMAGE_MODEL=grok-imagine-image

# Dirección que se incluirá en los códigos QR.
# Debe ser accesible desde los teléfonos del evento.
PUBLIC_BASE_URL=https://sadmonkey.com

# Directorio opcional para almacenar resultados.
# IMAGES_DIR=./generated_images

# URL del servidor vista desde Android.
# Emulador estándar: http://10.0.2.2
# Dispositivo físico: usar la IP local del servidor.
EXPO_PUBLIC_API_URL=https://sadmonkey.com
